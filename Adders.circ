    <comp lib="8" loc="(7735,2030)" name="Text">
      <a name="text" val="The problem is that this module is significantly larger than a Ripple Carry Adder tasked with computing the same number."/>
    </comp>
    <comp lib="8" loc="(7735,2055)" name="Text">
      <a name="text" val="(The 16-bit Ripple Carry Adder would take 32 units of time to produce a sum and 30.5 units of time to produce a carry-out.)"/>
    </comp>
    <comp lib="8" loc="(7745,1500)" name="Text">
      <a name="color" val="#ff0001"/>
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="10.5"/>
    </comp>
    <comp lib="8" loc="(7765,2005)" name="Text">
      <a name="text" val="This computes the addition of two 16-bit numbers in a fraction of the time that it would take a 16-bit Ripple Adder to do the same. "/>
    </comp>
    <comp lib="8" loc="(7865,710)" name="Text">
