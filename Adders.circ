    <comp lib="8" loc="(9175,1410)" name="Text">
      <a name="text" val="C4 = G3 + P3*G2 + P3*P2*G1 + P3*P2*P1*G0 + P3*P2*P1*P0*C0"/>
    </comp>
    <comp lib="8" loc="(9195,2210)" name="Text">
      <a name="text" val="C4 = G3 + P3*G2 + P3*P2*G1 + P3*P2*P1*G0 + P3*P2*P1*P0*C0"/>
    </comp>
