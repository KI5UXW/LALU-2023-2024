    <comp lib="8" loc="(750,1015)" name="Text">
      <a name="color" val="#ff0002"/>
      <a name="text" val="1101 1110 / DE = Loads 01 into Register D."/>
    </comp>
    <comp lib="8" loc="(770,1030)" name="Text">
      <a name="color" val="#ff0002"/>
      <a name="text" val="0011 0010 / 32 = Adds Register D to Register A."/>
    </comp>
    <comp lib="8" loc="(770,1070)" name="Text">
      <a name="color" val="#ff0002"/>
      <a name="text" val="1011 0010 / B2 = Adds Register D to Register C."/>
    </comp>
    <comp lib="8" loc="(770,1110)" name="Text">
      <a name="color" val="#ff0002"/>
      <a name="text" val="0001 0010 / 12 = Adds Register B to Register A."/>
    </comp>
    <comp lib="8" loc="(770,1180)" name="Text">
      <a name="color" val="#ff0002"/>
      <a name="text" val="1011 0010 / B2 = Adds Register D to Register C."/>
    </comp>
    <comp lib="8" loc="(785,1215)" name="Text">
      <a name="color" val="#ff0002"/>
      <a name="text" val="0001 0011 / 13 = Subtracts Register B to Register A."/>
    </comp>
    <comp lib="8" loc="(835,975)" name="Text">
      <a name="color" val="#ff0002"/>
      <a name="text" val="Program Code:"/>
    </comp>
    <comp lib="8" loc="(845,995)" name="Text">
      <a name="color" val="#ff0002"/>
      <a name="text" val="0000 1111 / 0F = Loads data memory at address 00 to Register A."/>
    </comp>
    <comp lib="8" loc="(890,1200)" name="Text">
      <a name="color" val="#ff0002"/>
      <a name="text" val="0110 1111 / 6F = Loads data memory location from Register C into Register B."/>
    </comp>
    <comp lib="8" loc="(895,1090)" name="Text">
      <a name="color" val="#ff0002"/>
      <a name="text" val="0110 1111 / 6F = Loads data memory location from Register C into Register B."/>
    </comp>
